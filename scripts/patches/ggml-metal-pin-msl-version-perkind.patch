+// When MTLCompileOptions.languageVersion is left unset, Metal derives the MSL
+// version from the SDK the *host process* was linked against -- not from the
+// running OS. That makes shader compilation depend on which binary loaded ggml.
+// Loaded into an interpreter linked against an old SDK (python.org's CPython
+// 3.12 links the macOS 12.1 SDK), the default drops below MSL 3.1 and the
+// library fails to compile outright:
+//
+//   error: no matching constructor for initialization of
+//          'threadgroup metal::half4x4[512]'
+//
+// leaving ggml_metal_device_init with no library and no Metal backend. Below
+// MSL 3.1 the bf16 kernels are also silently #undef'd (see the .metal sources)
+// while props.has_bfloat stays true, so the failure mode there is worse than a
+// clean error.
+//
+// Pin the version so behaviour follows the machine, not the host binary. The
+// ladder stays below MSL 4.0: the Metal 4 tensor headers remain unavailable and
+// the tensor probe keeps taking its existing "unsupported" path.
+static void ggml_metal_set_language_version(MTLCompileOptions * options) {
+    // spelled numerically so this still builds against SDKs predating the enum
+    // constants, matching the MTLGPUFamilyMetal4_GGML precedent elsewhere here
+    const NSUInteger msl_3_0 = (3 << 16) | 0;
+    const NSUInteger msl_3_1 = (3 << 16) | 1;
+    const NSUInteger msl_3_2 = (3 << 16) | 2;
+
+    if (@available(macOS 15.0, iOS 18.0, tvOS 18.0, *)) {
+        options.languageVersion = (MTLLanguageVersion) msl_3_2;
+    } else if (@available(macOS 14.0, iOS 17.0, tvOS 17.0, *)) {
+        options.languageVersion = (MTLLanguageVersion) msl_3_1;
+    } else if (@available(macOS 13.0, iOS 16.0, tvOS 16.0, *)) {
+        // MSL 3.1 does not exist here; 3.0 still compiles the library, but the
+        // bf16 kernels are compiled out -- an OS ceiling, not a choice.
+        options.languageVersion = (MTLLanguageVersion) msl_3_0;
+    }
+}
